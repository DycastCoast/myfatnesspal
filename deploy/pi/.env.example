# Copy to .env (git-ignored) and fill in.

# Your Tailscale login, exactly as `tailscale status --json | grep LoginName` shows it
# (e.g. you@gmail.com, or DycastCoast@github if you sign in to Tailscale with GitHub).
ALLOWED_LOGINS=you@gmail.com

# The email your diary was saved under on montlab (the one you logged in to Cloudflare with).
# Whoever is allowed in uses this diary, so your history carries over.
ACCOUNT_EMAIL=you@gmail.com

# Lets that account download backups from Settings.
ADMIN_EMAILS=you@gmail.com
